data <- read.csv(url("https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv"))
plot(data$reserved, data$water)
plot(data$water, data$reserved)
plot(data$reserved, data$water)
plot(x=data$reserved, y=data$water,
ylab = "Number of new or repaired drinking water facilities in the villages",
xlab = "Binary variable indicating if there are spaces on the councils reserved for women",)
