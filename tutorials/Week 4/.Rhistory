col = df$cap + 1,
xlab = "University level education (in years)",
ylab = "Monthly net income (in Euro)",
main = "The relationship between education and income")
legend("topleft",
legend = c("Non-capital", "Capital"),
col = c("black", "red"),
pch = 1)
